# Supabase project URL and anon (public) key. Locally: `npx -y supabase@2.120.0 status` (API URL, anon key).
# The web app holds only these Supabase settings. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL of this web app (not secret). The app itself no longer reads it; only the Playwright config and CI
# set it, to the address the e2e server runs on.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Coach (server-only, set on the web host, never NEXT_PUBLIC_): ANTHROPIC_API_KEY, LLM_API_KEY, LLM_BASE_URL,
# NVIDIA_API_KEY. See docs/ops/web.md section 7. Leave them out of this file.
